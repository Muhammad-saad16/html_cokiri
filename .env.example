# Copy this file to .env.local and fill in the values.

# ---- CMS (Payload) ----
# Long random string used to sign admin logins. Never share it.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Local SQLite database file. For hosting (e.g. Vercel) use a Turso/libSQL URL instead.
DATABASE_URI=file:./kangan.db

# ---- Order email (optional) ----
# Orders are always saved in the admin panel (Shop → Orders).
# Fill these in to also receive every order by email.
ORDER_EMAIL=orders@example.com

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
