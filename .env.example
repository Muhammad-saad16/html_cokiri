# Copy this file to .env.local and fill in the values.

# Where new orders are emailed
ORDER_EMAIL=orders@example.com   # optional — orders are also saved in the admin panel

# SMTP account used to send the email.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ---- Payload CMS (admin panel at /admin) ----
# Long random text, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Database. Locally leave as is (file kangan.db).
# Vercel: create a Turso database (turso.tech or Vercel → Storage → Turso) and paste its URL + token.
DATABASE_URI=file:./kangan.db
DATABASE_AUTH_TOKEN=

# Photos & videos uploaded in /admin. Needed on Vercel (Vercel → Storage → Blob → connect to project).
BLOB_READ_WRITE_TOKEN=
